# Primary LLM: any OpenAI-compatible endpoint
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b

# Optional fallback, used when the primary is rate-limited or down (all three or none).
# Groq quotas are per model, so another Groq model with the same key is a cheap fallback;
# Gemini's free tier also works but allows only ~20 requests/day.
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# https://superheroapi.com (sign in with GitHub)
SUPERHERO_API_TOKEN=

# Optional, benchmark only: an LLM judge for answers keywords can't grade. Use a different model or quota
# from the bot so grading doesn't eat its rate limit.
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=qwen/qwen3.8-27b
